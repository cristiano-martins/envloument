# Copia para .env (local) ou define estas variáveis no Railway → Variables. NUNCA coloques chaves reais no código nem no Git.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
CONTACT_EMAIL=envlomenttechnologies@gmail.com
RESEND_FROM_EMAIL=onboarding@resend.dev      # em produção: um endereço de um domínio verificado no Resend
RESEND_FROM_NAME=Envloument
# RESEND_TIMEOUT=10

SESSION_SECRET=
ADMIN_PASSWORD=

# ── Segurança (Railway → Variables; marca as chaves como "sealed") ──
# SESSION_SECRET=<32+ caracteres aleatórios>      # openssl rand -hex 32
# ADMIN_PASSWORD=<12+ caracteres>                 # ativa /admin
# ADMIN_IPS=1.2.3.4,5.6.7.8                       # opcional: só estes IPs acedem ao /admin
# IP_CONFIANCA=1.2.3.4                            # opcional: IPs que nunca são bloqueados
# ORIGIN_CHECK=1                                  # 0 só para diagnóstico (desativa a verificação de Origin nos POST)
